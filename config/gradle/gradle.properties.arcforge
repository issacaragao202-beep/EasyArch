# ==============================================================================
# EasyArch — gradle.properties para Minecraft 1.20.1 / Fabric / ArcForge
# Destino recomendado: ~/.gradle/gradle.properties ou raiz do projeto ArcForge
#
# Justificativa (Hardware: ~6 GB RAM utilizáveis, Ryzen 5 3400G 4C/8T):
#   - Limita heap da JVM a 2048 MiB para evitar pressão extrema de OOM.
#   - Desativa daemon residente (org.gradle.daemon=false) para devolver 100% da RAM
#     assim que a compilação termina.
#   - Limita workers a 4 para não saturar largura de banda single-channel.
# ==============================================================================

org.gradle.java.home=/usr/lib/jvm/java-17-openjdk
org.gradle.jvmargs=-Xmx2048m -XX:MaxMetaspaceSize=512m -XX:+UseG1GC
org.gradle.daemon=false
org.gradle.parallel=true
org.gradle.workers.max=4
org.gradle.caching=true
